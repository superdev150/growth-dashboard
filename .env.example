APP_NAME="Growth Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# No database: the app is stateless. Caches and sessions live on disk.
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# demo = deterministic sample data, no keys needed. live = RevenueCat + Meta Ads.
GROWTH_DRIVER=demo
GROWTH_CURRENCY=USD

# live: one RevenueCat project per app, each with a v2 secret key (charts_metrics:charts:read).
RC_NOTES_PROJECT=
RC_NOTES_KEY=
RC_TRAILS_PROJECT=
RC_TRAILS_KEY=

# live: a read-only Meta token (ads_read) and the ad account (act_…).
META_TOKEN=
META_AD_ACCOUNT=
# Units of the ad account's currency per 1 USD, used only if the exchange-rate service has never answered.
META_FALLBACK_RATE=
