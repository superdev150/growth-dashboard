* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Laravel's generated skeleton is not authored code: keep it out of the language stats.
config/*.php linguist-vendored
config/growth.php -linguist-vendored
public/index.php linguist-vendored
bootstrap/providers.php linguist-vendored
artisan linguist-vendored
